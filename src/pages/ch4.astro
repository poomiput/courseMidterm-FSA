    </div>

    <div class="tablewrap" style="margin-top:20px">
      <table>
        <caption>% ของรายได้สุทธิ (Net Revenue) — เห็นทุกบรรทัดเทียบกับยอดขายพร้อมกัน</caption>
        <thead><tr><th scope="col">รายการ</th><th scope="col">จำนวน</th><th scope="col">% ของรายได้สุทธิ</th></tr></thead>
        <tbody>
          <tr><th scope="row">กำไรสุทธิ</th><td>$2,210</td><td>9.37%</td></tr>
          <tr><th scope="row">ค่าเสื่อมราคา</th><td>1,052</td><td>4.46%</td></tr>
          <tr><th scope="row">กำไรจากขายอุปกรณ์</th><td>(205)</td><td>(0.87%)</td></tr>
          <tr><th scope="row">ลูกหนี้เพิ่มขึ้น</th><td>(55)</td><td>(0.23%)</td></tr>
          <tr><th scope="row">สินค้าคงเหลือเพิ่มขึ้น</th><td>(707)</td><td>(3.00%)</td></tr>
          <tr><th scope="row">เจ้าหนี้เพิ่มขึ้น</th><td>263</td><td>1.11%</td></tr>
