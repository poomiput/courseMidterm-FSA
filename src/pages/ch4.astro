          <tr><th scope="row"><b>เงินสดสุทธิใช้ไปในการลงทุน</b></th><td><b>(538)</b></td><td><b>(2.28%)</b></td></tr>
          <tr><th scope="row"><b>เงินสดสุทธิใช้ไปในการจัดหาเงิน</b></th><td><b>(2,220)</b></td><td><b>(9.41%)</b></td></tr>
